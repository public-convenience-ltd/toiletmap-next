{
	"name": "toiletmap-client",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
 "assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
  "vars": {
    "ENVIRONMENT": "preview",
    "PUBLIC_API_URL": "https://toiletmap-server.gbtoiletmap.workers.dev",
    "AUTH0_ISSUER_BASE_URL": "http://127.0.0.1:44555/",
    "AUTH0_CLIENT_ID": "toiletmap-client-dev",
    "AUTH0_CLIENT_SECRET": "dev-secret",
    "AUTH0_SCOPE": "openid profile email",
    "AUTH0_AUDIENCE": "https://toiletmap.org.uk",
    "AUTH0_REDIRECT_URI": "http://localhost:4321/auth/callback"
  },
  "env": {
    "preview": {
      "vars": {
        "ENVIRONMENT": "preview",
        "PUBLIC_API_URL":"https://toiletmap-server.gbtoiletmap.workers.dev"
      }
    },
    "production": {
      "name": "toiletmap-client",
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_API_URL": "https://toiletmap-server.gbtoiletmap.workers.dev"
      }
    }
  },
	"observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
