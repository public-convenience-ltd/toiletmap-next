---
import { env } from "cloudflare:workers";
import LooMap from "../components/LooMap";
import Layout from "../layouts/Layout.astro";

const apiUrl = env.PUBLIC_API_URL;
---

<Layout>
  <main>
    <LooMap client:only="preact" apiUrl={apiUrl} />
  </main>
</Layout>

<style>
  main {
    position: relative;
    height: 100vh;
    width: 100vw;
    overflow: hidden;
  }
</style>
