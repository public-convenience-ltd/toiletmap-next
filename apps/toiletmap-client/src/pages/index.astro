---
import { env } from "cloudflare:workers";
import LooMap from "../components/LooMap";
import MapLayout from "../layouts/MapLayout.astro";

import { BROWSER_API_URL } from "../utils/api";
import { sessionCanWriteDirectly } from "../utils/permissions";
import { siteJsonLd } from "../utils/seo";

// Browser islands call the same-origin /api/* proxy.
const apiUrl = BROWSER_API_URL;
// Only for the copy ("goes live straight away" vs "a moderator will check"): the API decides.
const canWriteDirectly = sessionCanWriteDirectly(Astro.cookies);
---

<MapLayout canonical="/" jsonLd={siteJsonLd(Astro.site)}>
  <h1 class="visually-hidden">Toilet Map</h1>
  <LooMap
    client:only="preact"
    apiUrl={apiUrl}
    canWriteDirectly={canWriteDirectly}
    environment={env.ENVIRONMENT}
  />
</MapLayout>
