---
import { Footer, Header } from "toiletmap-design-system";
import logo from "../../assets/logo.svg?url";
import LooForm from "../../components/LooForm/LooForm";
import { mapViewFromSearch } from "../../components/LooMap/mapView";
import Layout from "../../layouts/Layout.astro";

import { BROWSER_API_URL } from "../../utils/api";
import { sessionCanWriteDirectly } from "../../utils/permissions";
import { loginHref } from "../../utils/returnTo";

// LooForm calls the same-origin /api/* proxy, which attaches the access token
// server-side; the token is never rendered into the page.
const apiUrl = BROWSER_API_URL;
const isAuthenticated = !!Astro.cookies.get("user_info")?.value;
// Only for the copy ("goes live straight away" vs "a moderator will check"): the API decides.
const canWriteDirectly = sessionCanWriteDirectly(Astro.cookies);

// "Add a toilet here" on the map links to /loos/add?lat&lng&zoom; the picker opens there.
const initialView = mapViewFromSearch(Astro.url.search);

const navLinks = [
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
  { href: "/feedback", label: "Feedback" },
  { href: "/loos/add", label: "Add a toilet", button: true },
  isAuthenticated
    ? { href: "/auth/logout", label: "Sign out" }
    : { href: loginHref(`${Astro.url.pathname}${Astro.url.search}`), label: "Sign in" },
];
---

<Layout>
  <Header client:load logoSrc={logo} navLinks={navLinks} />
  <main>
    <LooForm
      client:only="preact"
      mode="add"
      apiUrl={apiUrl}
      initialView={initialView}
      isAuthenticated={isAuthenticated}
      canWriteDirectly={canWriteDirectly}
    />
  </main>
  <Footer />
</Layout>

<style>
  main {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }
</style>
