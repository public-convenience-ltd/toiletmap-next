---
/**
 * "Report a problem" with a toilet (the legacy `/loos/:id/remove` URL).
 * The ReportProblem island posts to the same-origin /api proxy.
 */
import { env } from "cloudflare:workers";
import ReportProblem from "../../../components/ReportProblem/ReportProblem";
import SiteChrome from "../../../components/SiteChrome/SiteChrome.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { BROWSER_API_URL } from "../../../utils/api";
import { loadLoo, notFoundResponse } from "../../../utils/looPage";
import { looDisplayName } from "../../../utils/looSeo";
import { sessionCanWriteDirectly } from "../../../utils/permissions";
import { pageTitle } from "../../../utils/seo";
import { hasSignedInFlag } from "../../../utils/session";

const { id } = Astro.params;

const apiUrl = BROWSER_API_URL;
const isAuthenticated = hasSignedInFlag(Astro.cookies);
// Only for the copy ("goes live straight away" vs "a moderator will check"): the API decides.
const canWriteDirectly = sessionCanWriteDirectly(Astro.cookies);

// SSR fetch goes straight upstream (service binding or PUBLIC_API_URL), not via the proxy.
const load = await loadLoo({
  env,
  url: Astro.url,
  id,
  clientIp: Astro.request.headers.get("cf-connecting-ip"),
  purpose: "reporting",
});
// Unknown toilet: the site's 404 page. API down: the site's error page (500.astro).
if (load.kind === "not-found") return notFoundResponse();
if (load.kind === "unavailable") return new Response(null, { status: 500 });
const toilet = load.loo;
const returnTo = `/loos/${encodeURIComponent(id ?? toilet.id)}/remove`;
---

<BaseLayout title={pageTitle(`Report a problem with ${looDisplayName(toilet)}`)} noindex>
  <SiteChrome signInReturnTo={returnTo}>
    <main>
      <ReportProblem
        client:only="preact"
        loo={toilet}
        apiUrl={apiUrl}
        isAuthenticated={isAuthenticated}
        canWriteDirectly={canWriteDirectly}
      />
    </main>
  </SiteChrome>
</BaseLayout>
