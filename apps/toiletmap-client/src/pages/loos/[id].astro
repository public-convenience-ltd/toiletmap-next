---
import { Footer, Header } from "toiletmap-design-system";
import logo from "../../assets/logo.svg?url";
import LooMap from "../../components/LooMap";
import Layout from "../../layouts/Layout.astro";

const { id } = Astro.params;

import { BROWSER_API_URL } from "../../utils/api";

// Browser islands call the same-origin /api/* proxy.
const apiUrl = BROWSER_API_URL;
const isAuthenticated = !!Astro.cookies.get("user_info")?.value;

const navLinks = [
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
  { href: "/feedback", label: "Feedback" },
  { href: "/loos/add", label: "Add a Toilet", button: true },
  isAuthenticated
    ? { href: "/auth/logout", label: "Sign out" }
    : { href: "/auth/login", label: "Sign in" },
];
---

<Layout>
  <Header client:load logoSrc={logo} navLinks={navLinks} />
  <main>
    <LooMap client:only="preact" apiUrl={apiUrl} initialToiletId={id} />
  </main>
  <Footer />
</Layout>

<style>
  main {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
  }
</style>
