---
import { env } from "cloudflare:workers";
import { defaultFooterLinks, Footer, Header } from "toiletmap-design-system";
import logo from "../../assets/logo.svg?url";
import LooMap from "../../components/LooMap";
import Layout from "../../layouts/Layout.astro";

const { id } = Astro.params;

import { BROWSER_API_URL } from "../../utils/api";
import { sessionCanWriteDirectly } from "../../utils/permissions";

// Browser islands call the same-origin /api/* proxy.
const apiUrl = BROWSER_API_URL;
const isAuthenticated = !!Astro.cookies.get("user_info")?.value;
// Only for the copy ("goes live straight away" vs "a moderator will check"): the API decides.
const canWriteDirectly = sessionCanWriteDirectly(Astro.cookies);

const navLinks = [
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
  { href: "/feedback", label: "Feedback" },
  { href: "/loos/add", label: "Add a Toilet", button: true },
  isAuthenticated
    ? { href: "/auth/logout", label: "Sign out" }
    : { href: "/auth/login", label: "Sign in" },
];
---

<Layout bodyClass="map-page">
  <Header
    client:load
    logoSrc={logo}
    navLinks={navLinks}
    drawerLinks={defaultFooterLinks}
  />
  <main>
    <h1 class="visually-hidden">Toilet Map</h1>
    <LooMap
      client:only="preact"
      apiUrl={apiUrl}
      initialToiletId={id}
      canWriteDirectly={canWriteDirectly}
      environment={env.ENVIRONMENT}
    />
  </main>
  <!-- Below 768px the map takes the whole screen; the footer links are in the menu. -->
  <Footer hideOnMobile />
</Layout>

<style>
  main {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
  }
</style>
