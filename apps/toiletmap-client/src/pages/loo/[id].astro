---
import { env } from "cloudflare:workers";
import { Footer, Header } from "toiletmap-design-system";
import logo from "../../assets/logo.svg?url";
import LooMap from "../../components/LooMap";
import Layout from "../../layouts/Layout.astro";

const { id } = Astro.params;
const apiUrl = env.PUBLIC_API_URL;

const navLinks = [
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
  { href: "/feedback", label: "Feedback" },
  { href: "/loo/add", label: "Add a Toilet", button: true },
];
---

<Layout>
  <Header client:load logoSrc={logo} navLinks={navLinks} />
  <main>
    <LooMap client:only="preact" apiUrl={apiUrl} initialToiletId={id} />
  </main>
  <Footer />
</Layout>

<style>
  main {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
  }
</style>
