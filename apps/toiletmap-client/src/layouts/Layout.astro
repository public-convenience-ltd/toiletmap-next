---
interface Props {
  /**
   * Classes for <body>. Map pages pass "map-page": the page is exactly one
   * screen tall and never scrolls (the map pans instead). Every other page
   * scrolls normally.
   */
  bodyClass?: string;
  /** The document title. Defaults to "Toilet Map". */
  title?: string;
}

const { bodyClass, title = "Toilet Map" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<!-- viewport-fit=cover lets the page reach under notches; the design system's
		     --safe-* properties pad the header, footer and panels clear of them. -->
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<!-- --color-primary-navy -->
		<meta name="theme-color" content="#0a165e" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<!-- Extra head content from the page, e.g. <meta slot="head" name="robots" …>. -->
		<slot name="head" />
	</head>
	<body class:list={[bodyClass]}>
		<slot />
	</body>
</html>

<style is:global>
	@import "toiletmap-design-system/stylesheet.css";

	/* Header, main, footer: the footer sits at the bottom of short pages. */
	body {
		display: flex;
		flex-direction: column;
		min-height: var(--app-height);
	}

	/* Map pages fill the visible viewport exactly; only the map moves. */
	body.map-page {
		height: var(--app-height);
		overflow: hidden;
	}

	/*
	 * Other pages scroll the document, not <main>: the mobile URL bar can then
	 * collapse, and sticky bars (the form's Save bar) stick to the viewport.
	 * Overrides the per-page `main { overflow-y: auto }` on the form pages.
	 */
	body:not(.map-page) > main {
		flex: 1 0 auto;
		overflow: visible;
	}

	/* Astro islands should not create layout boxes — let children be direct flex items */
	astro-island {
		display: contents;
	}
</style>
