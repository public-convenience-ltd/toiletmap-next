# Response headers for static assets (Cloudflare Workers static assets). The build adds a
# long-lived Cache-Control rule for /_astro/* to this file.

# The CMS (public/cms/) is for editors: keep it out of search results and other sites' frames.
/cms
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
/cms/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
