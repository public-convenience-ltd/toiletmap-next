{
  "name": "toiletmap-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo for Toilet Map workers",
  "scripts": {
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci:check": "biome ci .",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.13.1",
      "valibot@>=0.31.0 <1.2.0": ">=1.2.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "husky": "^9.1.7",
    "typescript": "7.0.2",
    "wrangler": "^4.120.0"
  }
}
